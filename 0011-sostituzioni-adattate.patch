+export interface RoleBucketCounts {
+  gk: number;
+  def: number;
+  mid: number;
+  att: number;
+}
+
+/**
+ * Verifica se una composizione di ruoli (conteggio per bucket) rispetta i
+ * requisiti minimi di un modulo Mantra consentito: esattamente 1 portiere,
+ * almeno 3 difensori, almeno 1 attaccante. È la stessa regola applicata da
+ * validateFormation (app/actions/lineup.ts) alla formazione schierata, e
+ * viene riusata anche per le "sostituzioni adattate" a giornata giocata
+ * (app/lib/voteImporter.ts): un cambio è permesso solo se la composizione
+ * risultante resta un modulo consentito secondo questa stessa regola —
+ * unica fonte di verità condivisa dai due file.
+ */
+export function isValidRoleComposition(counts: RoleBucketCounts): boolean {
+  return counts.gk === 1 && counts.def >= 3 && counts.att >= 1;
+}
